generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model ai_requests {
  id           BigInt         @id @default(autoincrement())
  user_id      BigInt
  branch_id    BigInt?
  prompt       String         @db.Text
  created_at   DateTime       @db.DateTime(0)
  branches     branches?      @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ai_requests_branch")
  users        users          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ai_requests_user")
  ai_responses ai_responses[]

  @@index([branch_id], map: "fk_ai_requests_branch_idx")
  @@index([user_id], map: "fk_ai_requests_user_idx")
}

model ai_responses {
  id            BigInt      @id @default(autoincrement())
  request_id    BigInt
  response_text String      @db.Text
  model_name    String?     @db.VarChar(100)
  created_at    DateTime    @db.DateTime(0)
  ai_requests   ai_requests @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ai_responses_request")

  @@index([request_id], map: "fk_ai_responses_request_idx")
}

model assessment_attempts {
  id                 BigInt               @id @default(autoincrement())
  assessment_id      BigInt
  student_id         BigInt
  attempt_no         Int
  started_at         DateTime?            @db.DateTime(0)
  submitted_at       DateTime?            @db.DateTime(0)
  status             String?              @db.VarChar(30)
  assessments        assessments          @relation(fields: [assessment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assessment_attempts_assessment")
  students           students             @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assessment_attempts_student")
  assessment_results assessment_results[]

  @@index([assessment_id], map: "fk_assessment_attempts_assessment_idx")
  @@index([student_id], map: "fk_assessment_attempts_student_idx")
}

model assessment_results {
  id                  BigInt              @id @default(autoincrement())
  attempt_id          BigInt
  score               Decimal             @db.Decimal(5, 2)
  feedback            String?             @db.Text
  graded_by           BigInt?
  graded_at           DateTime?           @db.DateTime(0)
  published_at        DateTime?           @db.DateTime(0)
  status              String?             @db.VarChar(30)
  assessment_attempts assessment_attempts @relation(fields: [attempt_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assessment_results_attempt")
  users               users?              @relation(fields: [graded_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assessment_results_graded_by")

  @@index([attempt_id], map: "fk_assessment_results_attempt_idx")
  @@index([graded_by], map: "fk_assessment_results_graded_by_idx")
}

model assessments {
  id                  BigInt                @id @default(autoincrement())
  class_id            BigInt
  name                String                @db.VarChar(150)
  type                String?               @db.VarChar(50)
  max_score           Decimal               @db.Decimal(5, 2)
  scheduled_at        DateTime              @db.DateTime(0)
  status              String                @db.VarChar(30)
  created_by          BigInt
  assessment_attempts assessment_attempts[]
  classes             classes               @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assessments_class")
  users               users                 @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assessments_created_by")

  @@index([class_id], map: "fk_assessments_class_idx")
  @@index([created_by], map: "fk_assessments_created_by_idx")
}

model attendance_records {
  id             BigInt         @id @default(autoincrement())
  session_id     BigInt
  student_id     BigInt
  status         String         @db.VarChar(30)
  note           String?        @db.Text
  recorded_by    BigInt
  created_at     DateTime       @db.DateTime(0)
  users          users          @relation(fields: [recorded_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_records_recorded_by")
  class_sessions class_sessions @relation(fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_records_session")
  students       students       @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_records_student")

  @@index([recorded_by], map: "fk_attendance_records_recorded_by_idx")
  @@index([session_id], map: "fk_attendance_records_session_idx")
  @@index([student_id], map: "fk_attendance_records_student_idx")
}

model audit_logs {
  id          BigInt    @id @default(autoincrement())
  user_id     BigInt?
  branch_id   BigInt?
  action      String    @db.VarChar(100)
  entity_type String?   @db.VarChar(100)
  entity_id   BigInt
  old_data    String    @db.LongText
  new_data    String?   @db.LongText
  created_at  DateTime  @db.DateTime(0)
  branches    branches? @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_logs_branch")
  users       users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_logs_user")

  @@index([branch_id], map: "fk_audit_logs_branch_idx")
  @@index([user_id], map: "fk_audit_logs_user_idx")
}

model branches {
  id                 BigInt               @id @default(autoincrement())
  organization_id    BigInt
  code               String               @db.VarChar(150)
  address            String?              @db.VarChar(255)
  phone              String?              @db.VarChar(30)
  status             String               @db.VarChar(30)
  created_at         DateTime             @db.DateTime(0)
  ai_requests        ai_requests[]
  audit_logs         audit_logs[]
  organizations      organizations        @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_branches_organization")
  classes            classes[]
  course_offerings   course_offerings[]
  invoices           invoices[]
  leads              leads[]
  payments           payments[]
  placement_tests    placement_tests[]
  rooms              rooms[]
  students           students[]
  user_branch_scopes user_branch_scopes[]

  @@index([organization_id], map: "fk_branches_organization_idx")
}

model class_schedules {
  id          BigInt   @id @default(autoincrement())
  class_id    BigInt
  day_of_week Int
  start_time  DateTime @db.Time(0)
  end_time    DateTime @db.Time(0)
  classes     classes  @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_class_schedules_class")

  @@index([class_id], map: "fk_class_schedules_class_idx")
}

model class_sessions {
  id                 BigInt               @id @default(autoincrement())
  class_id           BigInt
  teacher_id         BigInt
  room_id            BigInt
  session_date       DateTime             @db.Date
  start_at           DateTime             @db.DateTime(0)
  end_at             DateTime             @db.DateTime(0)
  status             String               @db.VarChar(30)
  attendance_records attendance_records[]
  classes            classes              @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_class_sessions_class")
  rooms              rooms                @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_class_sessions_room")
  teachers           teachers             @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_class_sessions_teacher")

  @@index([class_id], map: "fk_class_sessions_class_idx")
  @@index([room_id], map: "fk_class_sessions_room_idx")
  @@index([teacher_id], map: "fk_class_sessions_teacher_idx")
}

model classes {
  id                  BigInt                @id @default(autoincrement())
  branch_id           BigInt
  code                String                @unique(map: "code_UNIQUE") @db.VarChar(50)
  name                String                @db.VarChar(100)
  status              String                @db.VarChar(30)
  course_offering_id  BigInt
  created_at          DateTime              @db.DateTime(0)
  room_id             BigInt?
  assessments         assessments[]
  class_schedules     class_schedules[]
  class_sessions      class_sessions[]
  branches            branches              @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_classes_branch")
  course_offerings    course_offerings      @relation(fields: [course_offering_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_classes_course_offering")
  rooms               rooms?                @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_classes_room")
  enrollments         enrollments[]
  teacher_assignments teacher_assignments[]

  @@index([branch_id], map: "fk_classes_branch_idx")
  @@index([course_offering_id], map: "fk_classes_course_offering_idx")
  @@index([room_id], map: "fk_classes_room_idx")
}

model course_offerings {
  id                BigInt          @id @default(autoincrement())
  branch_id         BigInt
  course_version_id BigInt
  code              String          @unique(map: "code_UNIQUE") @db.VarChar(50)
  status            String          @db.VarChar(30)
  start_date        DateTime        @db.Date
  end_date          DateTime        @db.Date
  max_students      Int?
  classes           classes[]
  branches          branches        @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_course_offerings_branch")
  course_versions   course_versions @relation(fields: [course_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_course_offerings_course_version")
  enrollments       enrollments[]

  @@index([branch_id], map: "fk_course_offerings_branch_idx")
  @@index([course_version_id], map: "fk_course_offerings_course_version_idx")
}

model course_versions {
  id               BigInt             @id @default(autoincrement())
  course_id        BigInt
  version_no       String             @db.VarChar(30)
  description      String?            @db.Text
  status           String             @db.VarChar(30)
  created_at       DateTime           @db.DateTime(0)
  tuition_fee      Decimal?           @db.Decimal(15, 2)
  course_offerings course_offerings[]
  courses          courses            @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_course_versions_course")
  enrollments      enrollments[]

  @@index([course_id], map: "fk_course_versions_course_idx")
}

model courses {
  id                 BigInt            @id @default(autoincrement())
  program_version_id BigInt
  level_id           BigInt
  code               String            @unique(map: "code_UNIQUE") @db.VarChar(50)
  name               String            @db.VarChar(150)
  description        String?           @db.Text
  course_versions    course_versions[]
  levels             levels            @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_courses_level")
  program_versions   program_versions  @relation(fields: [program_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_courses_program_version")

  @@index([level_id], map: "fk_courses_level_idx")
  @@index([program_version_id], map: "fk_courses_program_version_idx")
}

model enrollment_status_history {
  id            BigInt      @id @default(autoincrement())
  enrollment_id BigInt
  old_status    String?     @db.VarChar(30)
  new_status    String      @db.VarChar(30)
  changed_by    BigInt
  changed_at    DateTime    @db.DateTime(0)
  reason        String      @db.Text
  users         users       @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enrollment_status_history_changed_by")
  enrollments   enrollments @relation(fields: [enrollment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enrollment_status_history_enrollment")

  @@index([changed_by], map: "fk_enrollment_status_history_changed_by_idx")
  @@index([enrollment_id], map: "fk_enrollment_status_history_enrollment_idx")
}

model enrollments {
  id                        BigInt                      @id @default(autoincrement())
  student_id                BigInt
  course_offering_id        BigInt
  class_id                  BigInt?
  course_version_id         BigInt
  price_snapshot            Decimal                     @db.Decimal(15, 2)
  created_at                DateTime                    @db.DateTime(0)
  updated_at                DateTime?                   @db.DateTime(0)
  status                    String                      @db.VarChar(30)
  enrollment_status_history enrollment_status_history[]
  classes                   classes?                    @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enrollments_class")
  course_offerings          course_offerings            @relation(fields: [course_offering_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enrollments_course_offering")
  course_versions           course_versions             @relation(fields: [course_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enrollments_course_version")
  students                  students                    @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enrollments_student")
  invoices                  invoices[]

  @@index([class_id], map: "fk_enrollments_class_idx")
  @@index([course_offering_id], map: "fk_enrollments_course_offering_idx")
  @@index([course_version_id], map: "fk_enrollments_course_version")
  @@index([student_id], map: "fk_enrollments_student_idx")
}

model guardians {
  id                BigInt              @id @default(autoincrement())
  full_name         String              @db.VarChar(150)
  email             String?             @db.VarChar(150)
  phone             String?             @db.VarChar(30)
  created_at        DateTime            @db.DateTime(0)
  address           String?             @db.VarChar(255)
  user_id           BigInt?
  users             users?              @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_guardians_user")
  student_guardians student_guardians[]

  @@index([user_id], map: "fk_guardians_user_idx")
}

model invoices {
  id            BigInt        @id @default(autoincrement())
  branch_id     BigInt
  enrollment_id BigInt
  invoice_no    String        @unique(map: "invoice_no_UNIQUE") @db.VarChar(50)
  amount        Decimal       @db.Decimal(15, 2)
  due_date      DateTime?     @db.Date
  status        String        @db.VarChar(30)
  issued_at     DateTime      @db.DateTime(0)
  branches      branches      @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoices_branch")
  enrollments   enrollments   @relation(fields: [enrollment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoices_enrollment")
  payments      payments[]
  receivables   receivables[]

  @@index([branch_id], map: "fk_invoices_branch_idx")
  @@index([enrollment_id], map: "fk_invoices_enrollment_idx")
}

model languages {
  id       BigInt     @id @default(autoincrement())
  code     String     @unique(map: "code_UNIQUE") @db.VarChar(20)
  name     String     @db.VarChar(100)
  programs programs[]
}

model leads {
  id               BigInt            @id @default(autoincrement())
  branch_id        BigInt
  full_name        String            @db.VarChar(150)
  email            String?           @db.VarChar(150)
  phone            String?           @db.VarChar(30)
  source           String?           @db.VarChar(50)
  created_at       DateTime          @db.DateTime(0)
  status           String            @db.VarChar(30)
  assigned_user_id BigInt?
  users            users?            @relation(fields: [assigned_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_leads_assigned_user")
  branches         branches          @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_leads_branch")
  placement_tests  placement_tests[]

  @@index([assigned_user_id], map: "fk_leads_assigned_user_idx")
  @@index([branch_id], map: "fk_leads_branch_idx")
}

model levels {
  id                BigInt              @id @default(autoincrement())
  code              String              @unique(map: "code_UNIQUE") @db.VarChar(20)
  name              String              @db.VarChar(100)
  description       String?             @db.Text
  courses           courses[]
  placement_results placement_results[]
}

model organizations {
  id          BigInt     @id @default(autoincrement())
  code        String     @db.VarChar(50)
  name        String     @db.VarChar(150)
  description String?    @db.Text
  created_at  DateTime   @db.DateTime(0)
  branches    branches[]
}

model payments {
  id               BigInt   @id @default(autoincrement())
  branch_id        BigInt
  invoice_id       BigInt
  amount           Decimal  @db.Decimal(15, 2)
  payment_method   String?  @db.VarChar(30)
  transaction_code String?  @db.VarChar(100)
  paid_at          DateTime @db.DateTime(0)
  recorded_by      BigInt
  status           String   @db.VarChar(30)
  branches         branches @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payments_branch")
  invoices         invoices @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payments_invoice")
  users            users    @relation(fields: [recorded_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payments_recorded_by")

  @@index([branch_id], map: "fk_payments_branch_idx")
  @@index([invoice_id], map: "fk_payments_invoice_idx")
  @@index([recorded_by], map: "fk_payments_recorded_by_idx")
}

model permissions {
  id               BigInt             @id @default(autoincrement())
  code             String             @unique(map: "code_UNIQUE") @db.VarChar(100)
  name             String             @db.VarChar(150)
  module           String?            @db.VarChar(50)
  action           String?            @db.VarChar(50)
  description      String?            @db.Text
  role_permissions role_permissions[]
}

model placement_results {
  id                   BigInt          @id @default(autoincrement())
  placement_test_id    BigInt
  listening_score      Decimal?        @db.Decimal(5, 2)
  speaking_score       Decimal?        @db.Decimal(5, 2)
  reading_score        Decimal         @db.Decimal(5, 2)
  writing_score        Decimal         @db.Decimal(5, 2)
  total_score          Decimal         @db.Decimal(5, 2)
  recommended_level_id BigInt?
  reviewed_by          BigInt?
  reviewed_at          DateTime?       @db.DateTime(0)
  levels               levels?         @relation(fields: [recommended_level_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_placement_results_level")
  placement_tests      placement_tests @relation(fields: [placement_test_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_placement_results_placement_test")
  users                users?          @relation(fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_placement_results_users")

  @@index([recommended_level_id], map: "fk_placement_results_level_idx")
  @@index([reviewed_by], map: "fk_placement_results_level_idx1")
  @@index([placement_test_id], map: "fk_placement_results_placement_test_idx")
}

model placement_tests {
  id                BigInt              @id @default(autoincrement())
  branch_id         BigInt
  lead_id           BigInt?
  student_id        BigInt?
  test_date         DateTime            @db.DateTime(0)
  created_by        BigInt
  status            String              @db.VarChar(30)
  placement_results placement_results[]
  branches          branches            @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_placement_tests_branch")
  leads             leads?              @relation(fields: [lead_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_placement_tests_lead")
  students          students?           @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_placement_tests_student")
  users             users               @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_placement_tests_users")

  @@index([branch_id], map: "fk_placement_tests_branch_idx")
  @@index([lead_id], map: "fk_placement_tests_lead_idx")
  @@index([student_id], map: "fk_placement_tests_student_idx")
  @@index([created_by], map: "fk_placement_tests_student_idx1")
}

model program_versions {
  id          BigInt    @id @default(autoincrement())
  program_id  BigInt
  status      String    @db.VarChar(30)
  description String?   @db.Text
  version_no  String    @db.VarChar(30)
  created_at  DateTime  @db.DateTime(0)
  courses     courses[]
  programs    programs  @relation(fields: [program_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_program_versions_program")

  @@index([program_id], map: "fk_program_versions_program_idx")
}

model programs {
  id               BigInt             @id @default(autoincrement())
  code             String             @unique(map: "code_UNIQUE") @db.VarChar(20)
  name             String             @db.VarChar(100)
  description      String?            @db.Text
  language_id      BigInt
  program_versions program_versions[]
  languages        languages          @relation(fields: [language_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_placement_results_reviewed_by")

  @@index([language_id], map: "fk_placement_results_reviewed_by_idx")
}

model receivables {
  id               BigInt   @id @default(autoincrement())
  invoice_id       BigInt
  total_amount     Decimal  @db.Decimal(15, 2)
  paid_amount      Decimal  @db.Decimal(15, 2)
  remaining_amount Decimal  @db.Decimal(15, 2)
  status           String   @db.VarChar(30)
  updated_at       DateTime @db.DateTime(0)
  invoices         invoices @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_receivables_invoice")

  @@index([invoice_id], map: "fk_receivables_invoice_idx")
}

model role_permissions {
  id            BigInt      @id @default(autoincrement())
  role_id       BigInt
  permission_id BigInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_permissions_permission")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_permissions_role")

  @@index([permission_id], map: "fk_role_permissions_permission_idx")
  @@index([role_id], map: "fk_role_permissions_role_idx")
}

model roles {
  id               BigInt             @id @default(autoincrement())
  code             String             @unique(map: "code_UNIQUE") @db.VarChar(50)
  name             String             @db.VarChar(100)
  description      String?            @db.Text
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

model rooms {
  id             BigInt           @id @default(autoincrement())
  branch_id      BigInt
  code           String           @db.VarChar(50)
  name           String?          @db.VarChar(100)
  status         String           @db.VarChar(30)
  capacity       Int
  class_sessions class_sessions[]
  classes        classes[]
  branches       branches         @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rooms_branch")

  @@index([branch_id], map: "fk_rooms_branch_idx")
}

model student_guardians {
  id           BigInt    @id @default(autoincrement())
  guardian_id  BigInt
  relationship String?   @db.VarChar(50)
  is_primary   Int?      @db.TinyInt
  student_id   BigInt
  guardians    guardians @relation(fields: [guardian_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_student_guardians_guardian")
  students     students  @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_student_guardians_student")

  @@index([guardian_id], map: "fk_student_guardians_guardian_idx")
  @@index([student_id], map: "fk_student_guardians_student_idx")
}

model students {
  id                  BigInt                @id @default(autoincrement())
  branch_id           BigInt
  full_name           String                @db.VarChar(150)
  email               String?               @db.VarChar(150)
  phone               String?               @db.VarChar(30)
  gender              String?               @db.VarChar(20)
  created_at          DateTime              @db.DateTime(0)
  status              String                @db.VarChar(30)
  student_code        String                @unique(map: "student_code_UNIQUE") @db.VarChar(50)
  dob                 DateTime?             @db.Date
  address             String?               @db.VarChar(255)
  assessment_attempts assessment_attempts[]
  attendance_records  attendance_records[]
  enrollments         enrollments[]
  placement_tests     placement_tests[]
  student_guardians   student_guardians[]
  branches            branches              @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_students_branch")

  @@index([branch_id], map: "fk_students_branch_idx")
}

model teacher_assignments {
  id         BigInt    @id @default(autoincrement())
  class_id   BigInt
  teacher_id BigInt
  role       String    @db.VarChar(50)
  start_date DateTime? @db.Date
  end_date   DateTime? @db.Date
  classes    classes   @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_teacher_assignments_class")
  teachers   teachers  @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_teacher_assignments_teacher")

  @@index([class_id], map: "fk_teacher_assignments_class_idx")
  @@index([teacher_id], map: "fk_teacher_assignments_teacher_idx")
}

model teacher_qualifications {
  id                 BigInt    @id @default(autoincrement())
  teacher_id         BigInt
  qualification_type String?   @db.VarChar(100)
  title              String?   @db.VarChar(150)
  institution        String?   @db.VarChar(150)
  issued_date        DateTime? @db.Date
  expiry_date        DateTime? @db.Date
  document_url       String?   @db.VarChar(255)
  teachers           teachers  @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_teacher_qualifications_teacher")

  @@index([teacher_id], map: "fk_teacher_qualifications_teacher_idx")
}

model teachers {
  id                     BigInt                   @id @default(autoincrement())
  user_id                BigInt
  teacher_code           String                   @unique(map: "teacher_code_UNIQUE") @db.VarChar(50)
  full_name              String                   @db.VarChar(150)
  phone                  String?                  @db.VarChar(30)
  email                  String                   @db.VarChar(150)
  employment_status      String?                  @db.VarChar(30)
  created_at             DateTime                 @db.DateTime(0)
  class_sessions         class_sessions[]
  teacher_assignments    teacher_assignments[]
  teacher_qualifications teacher_qualifications[]
  users                  users                    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_teachers_user")

  @@index([user_id], map: "fk_teachers_user_idx")
}

model user_branch_scopes {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  branch_id  BigInt
  created_at DateTime @db.DateTime(0)
  branches   branches @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_branch_scopes_branch")
  users      users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_branch_scopes_user")

  @@index([user_id], map: "fk_role_permissions_permission_idx")
  @@index([branch_id], map: "fk_user_branch_scopes_branch_idx")
}

model user_roles {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  role_id    BigInt
  created_at DateTime @db.DateTime(0)
  roles      roles    @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_roles_roles")
  users      users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_roles_user")

  @@index([user_id], map: "fk_user_roles_user_idx")
  @@index([role_id], map: "fk_user_roles_user_idx1")
}

model users {
  id                        BigInt                      @id @default(autoincrement())
  username                  String                      @unique(map: "username_UNIQUE") @db.VarChar(100)
  password_hash             String                      @db.VarChar(255)
  full_name                 String                      @db.VarChar(150)
  email                     String?                     @db.VarChar(150)
  phone                     String?                     @db.VarChar(30)
  status                    String                      @db.VarChar(30)
  created_at                DateTime                    @db.DateTime(0)
  ai_requests               ai_requests[]
  assessment_results        assessment_results[]
  assessments               assessments[]
  attendance_records        attendance_records[]
  audit_logs                audit_logs[]
  enrollment_status_history enrollment_status_history[]
  guardians                 guardians[]
  leads                     leads[]
  payments                  payments[]
  placement_results         placement_results[]
  placement_tests           placement_tests[]
  teachers                  teachers[]
  user_branch_scopes        user_branch_scopes[]
  user_roles                user_roles[]
}
